# Copy this file to `.env` and adjust for your machine.
# `.env` is git-ignored — each developer keeps their own copy.

# -----------------------------------------------------------------------------
# Backend API base URL
# -----------------------------------------------------------------------------
# Pick the line that matches how you are running the app:

# Option 1: Use localhost backend (comment out Option 2)
# For Android emulator, use 10.0.2.2 instead of localhost
#API_BASE_URL=http://10.0.2.2:3000/api

# Option 2: Use Render deployment (comment out Option 1)
 API_BASE_URL=https://project-maa.onrender.com/api

# For different mobile setups with localhost:
#   iOS simulator (Mac): http://localhost:3000/api
#   Android emulator (AVD): http://10.0.2.2:3000/api  
#   Physical Android phone over USB: http://localhost:3000/api (run `adb reverse tcp:3000 tcp:3000` first)
#   Physical phone over Wi-Fi: http://YOUR_LAPTOP_IP:3000/api