{
  "name": "meditation-app-backend",
  "version": "1.0.0",
  "description": "Backend API for meditation app",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest tests/auth.integration.test.ts tests/auth.validator.test.ts tests/courses.controller.test.ts tests/habits.controller.test.ts tests/payments.controller.test.ts tests/subscriptions.controller.test.ts tests/directory.controller.test.ts tests/events.controller.test.ts",
    "test:watch": "jest --watch",
    "test:db": "node tests/run-all-tests.js",
    "test:quick": "node tests/quick-test.js",
    "test:summary": "node tests/test-summary.js",
    "setup:db": "node scripts/setup-database.js",
    "migrate": "node scripts/setup-database.js",
    "test:connection": "node scripts/test-connection.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.16.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
    "@types/supertest": "^2.0.16",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "meditation",
    "api",
    "supabase",
    "postgresql"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.0.0"
  }
}
